{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/harness_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/harness_guard.py\" --runtime-bash"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/harness_watch.py\" --claude-statusline",
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/harness_watch.py\" --claude-subagent-statusline"
  }
}
